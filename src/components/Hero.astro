---
import { site } from '../config/site';
import SocialLinks from './SocialLinks.astro';

const portraits = ['/pics/4tuR0oZzN2U.jpeg', '/pics/Fd7y6vLyjpU.jpeg', '/pics/DoWCwQ5SLZU.jpeg', '/pics/ijr4LBVSELs.jpeg'];
---

<section class="hero relative overflow-hidden">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-scan" aria-hidden="true"></div>
  <span class="hud-corner" style="top:18px;left:18px;border-left-width:2px;border-top-width:2px" aria-hidden="true"></span>
  <span class="hud-corner" style="top:18px;right:18px;border-right-width:2px;border-top-width:2px" aria-hidden="true"></span>

  <div class="relative mx-auto grid max-w-5xl items-center gap-12 px-4 py-24 sm:py-32 lg:grid-cols-[1fr_auto]">
    <div>
      <p class="rise font-mono text-xs tracking-[0.18em] text-[var(--color-accent-sky)]" style="animation-delay:.1s">
        <span class="status-dot" aria-hidden="true"></span>{site.kicker}
      </p>
      <h1 class="hero-name frost-text mt-5 font-display text-5xl font-light uppercase leading-none tracking-wide sm:text-7xl">
        {site.name}
      </h1>
      <p class="rise mt-6 max-w-2xl text-lg text-[var(--color-body)] sm:text-xl" style="animation-delay:.5s">
        {site.tagline}
      </p>
      <div class="rise mt-8 flex flex-wrap items-center gap-3" style="animation-delay:.65s">
        <a href="/projects" class="hud-btn hud-btn-solid">View Projects<span aria-hidden="true"> ▸</span></a>
        <a href="/contact" class="hud-btn hud-btn-ghost">Get in Touch</a>
      </div>
      <div class="rise mt-8" style="animation-delay:.8s">
        <SocialLinks />
      </div>
    </div>

    <div class="rise w-[240px] max-w-full justify-self-center lg:justify-self-end" style="animation-delay:.55s">
      <div class="portrait-frame relative aspect-[4/5] overflow-hidden rounded-lg">
        {
          portraits.map((src, i) => (
            <img
              src={src}
              alt={i === 0 ? `Portrait of ${site.name}` : ''}
              class:list={['portrait-img', i === 0 && 'is-active']}
              decoding="async"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          ))
        }
        <span class="hud-corner" style="top:8px;left:8px;border-left-width:2px;border-top-width:2px" aria-hidden="true"></span>
        <span class="hud-corner" style="bottom:8px;right:8px;border-right-width:2px;border-bottom-width:2px" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { background: var(--hero-gradient); }
  .hero-grid {
    position: absolute;
    inset: -40px;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg, transparent 0 26px, rgba(56, 189, 248, 0.09) 26px 27px),
      repeating-linear-gradient(90deg, transparent 0 26px, rgba(56, 189, 248, 0.09) 26px 27px);
    animation: hud-drift 14s linear infinite;
  }
  .hero-scan {
    position: absolute;
    top: -140px; /* start off-screen unconditionally (also keeps it hidden under reduced-motion) */
    left: 0;
    right: 0;
    height: 140px;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(56, 189, 248, 0.1), transparent);
    animation: hud-sweep 6s ease-in-out infinite;
  }
  .status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    margin-right: 8px;
    box-shadow: 0 0 10px var(--color-accent);
    animation: hud-pulse 1.8s ease-in-out infinite;
  }
  .hero-name {
    opacity: 0;
    width: max-content;
    max-width: 100%;
    animation: hud-rise 0.7s ease 0.3s forwards, hud-bloom 6s ease-in-out 1.4s infinite;
  }

  /* rotating portrait */
  .portrait-frame {
    border: 1px solid var(--color-border-strong);
    box-shadow: 0 0 40px rgba(34, 211, 238, 0.18);
    background: var(--color-bg-panel);
    transition: box-shadow 1s ease;
  }
  .portrait-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    opacity: 0;
    transition: opacity 1.2s ease, filter 1s ease;
  }
  .portrait-img.is-active {
    opacity: 1;
  }

  /* randomized photo effects (applied per-cycle by the rotator script) */
  .portrait-img.fx-normal { filter: none; }
  .portrait-img.fx-bw { filter: grayscale(1) contrast(1.05); }
  .portrait-img.fx-noir { filter: grayscale(1) contrast(1.45) brightness(0.92); }
  .portrait-img.fx-vintage { filter: sepia(0.55) contrast(1.1) saturate(1.25) brightness(0.96); }
  .portrait-img.fx-warm { filter: sepia(0.3) saturate(1.5) brightness(1.06); }
  .portrait-img.fx-faded { filter: contrast(0.9) brightness(1.12) saturate(0.8); }
  /* randomized frame glows */
  .portrait-frame.glow-blue { box-shadow: 0 0 30px rgba(97, 175, 239, 0.6); }
  .portrait-frame.glow-green { box-shadow: 0 0 30px rgba(152, 195, 121, 0.55); }
  .portrait-frame.glow-magenta { box-shadow: 0 0 30px rgba(198, 120, 221, 0.6); }
  .portrait-frame.glow-cyan { box-shadow: 0 0 30px rgba(86, 182, 194, 0.6); }

  @media (prefers-reduced-motion: reduce) {
    .hero-name { opacity: 1 !important; }
    .portrait-img { transition: none; }
  }
</style>

<script is:inline>
  (() => {
    const imgs = Array.from(document.querySelectorAll('.portrait-img'));
    const frame = document.querySelector('.portrait-frame');
    if (!imgs.length || !frame) return;

    const FX = ['fx-normal', 'fx-bw', 'fx-noir', 'fx-vintage', 'fx-warm', 'fx-faded'];
    // B&W / vintage family — guaranteed to land at least once every 4 turns
    const BW_VINTAGE = ['fx-bw', 'fx-noir', 'fx-vintage'];
    const GLOWS = ['', 'glow-blue', 'glow-green', 'glow-magenta', 'glow-cyan'];
    const pick = (a) => a[(Math.random() * a.length) | 0];
    const shuffle = (a) => {
      a = a.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = (Math.random() * (i + 1)) | 0;
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    };
    let turn = (Math.random() * 4) | 0; // random phase so the guaranteed turn varies per load
    const chooseFx = () => (turn % 4 === 0 ? pick(BW_VINTAGE) : pick(FX));
    const setFx = (img) => { FX.forEach((c) => img.classList.remove(c)); img.classList.add(chooseFx()); turn++; };
    const setGlow = () => { GLOWS.forEach((g) => g && frame.classList.remove(g)); const g = pick(GLOWS); if (g) frame.classList.add(g); };

    // start from whichever image is already active; give it a random look
    let cur = Math.max(0, imgs.findIndex((im) => im.classList.contains('is-active')));
    setFx(imgs[cur]);
    setGlow();

    if (imgs.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const others = () => shuffle(imgs.map((_, k) => k).filter((k) => k !== cur));
    let queue = others();
    let qi = 0;
    setInterval(() => {
      const next = queue[qi++];
      imgs[cur].classList.remove('is-active');
      setFx(imgs[next]);
      setGlow();
      imgs[next].classList.add('is-active');
      cur = next;
      if (qi >= queue.length) { queue = others(); qi = 0; }
    }, 4200);
  })();
</script>
