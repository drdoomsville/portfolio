---
// Looping marquee banner for the brutalist theme. Inert/hidden unless
// data-theme="brutalist" (see global.css). The phrase is duplicated so the
// -50% translate loops seamlessly.
const phrase = 'AVAILABLE FOR WORK ✶ AI ENGINEERING LEADER ✶ 30+ YEARS ✶ CHARLOTTE NC ✶ ';
---

<div class="brutal-marquee" aria-hidden="true">
  <div class="brutal-marquee-track">
    <span>{phrase.repeat(4)}</span>
    <span>{phrase.repeat(4)}</span>
  </div>
</div>
