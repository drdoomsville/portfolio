---
// Floating live theme switcher. Self-contained styling (independent of the
// active site theme) so it stays legible on every background. Persists choice
// to localStorage('site-theme'); BaseLayout's inline head script applies it
// before first paint to avoid a flash.
const themes = [
  { id: 'baseline', label: 'Baseline' },
  { id: 'corporate', label: 'Corporate' },
  { id: 'scifi', label: 'Sci-Fi Mech' },
  { id: 'programmer', label: 'Programmer' },
];
---

<div class="theme-switcher" role="group" aria-label="Site theme">
  <span class="theme-switcher__label">Theme</span>
  <div class="theme-switcher__options">
    {
      themes.map((t) => (
        <button type="button" class="theme-switcher__btn" data-theme-choice={t.id}>
          {t.label}
        </button>
      ))
    }
  </div>
</div>

<style>
  .theme-switcher {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 10px;
    background: rgba(10, 14, 20, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    font-family: ui-monospace, Menlo, Consolas, monospace;
  }
  .theme-switcher__label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8aa0b2;
  }
  .theme-switcher__options { display: flex; gap: 4px; }
  .theme-switcher__btn {
    cursor: pointer;
    font: inherit;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #cdd9e3;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 5px 9px;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .theme-switcher__btn:hover { background: rgba(255, 255, 255, 0.14); color: #fff; }
  .theme-switcher__btn[aria-pressed='true'] {
    background: #38bdf8;
    border-color: #38bdf8;
    color: #04121a;
  }
  .theme-switcher__btn:focus-visible { outline: 2px solid #38bdf8; outline-offset: 2px; }

  @media (max-width: 520px) {
    .theme-switcher { flex-direction: column; align-items: stretch; gap: 6px; right: 10px; bottom: 10px; }
    .theme-switcher__options { flex-wrap: wrap; }
  }
</style>

<script is:inline>
  (() => {
    const KEY = 'site-theme';
    const valid = ['baseline', 'corporate', 'scifi', 'programmer'];
    const root = document.documentElement;
    const btns = document.querySelectorAll('[data-theme-choice]');

    const current = () => {
      const t = root.getAttribute('data-theme');
      return valid.includes(t) ? t : 'baseline';
    };
    const sync = () => {
      const active = current();
      btns.forEach((b) =>
        b.setAttribute('aria-pressed', String(b.getAttribute('data-theme-choice') === active))
      );
    };
    const apply = (theme) => {
      root.setAttribute('data-theme', theme);
      try { localStorage.setItem(KEY, theme); } catch {}
      sync();
    };

    btns.forEach((b) => b.addEventListener('click', () => apply(b.getAttribute('data-theme-choice'))));
    sync();
  })();
</script>
